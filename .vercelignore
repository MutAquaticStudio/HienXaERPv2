# Keep local credentials, QA evidence and internal documents off hosting uploads.
.env*
/.git/
/.next/
/.vercel/
/node_modules/
/.pnpm-store/
/artifacts/
/qa/
/scripts/qa/
/tmp/
/supabase/.temp/
/supabase/.branches/
/playwright-report/
/test-results/
*.tsbuildinfo
/*.md
.DS_Store

# Frozen application-only Preview: omit local QA and non-runtime repository data.
/qa
/scripts
/supabase
/reports
/.github
/src/**/__tests__
/src/**/__mocks__
/src/**/*.test.*
/src/**/*.spec.*
/vitest.config.mts
