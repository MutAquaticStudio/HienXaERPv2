+/** Stock value / on hand across the branch's warehouses, whole đồng per base unit; null when nothing is on hand. */
+export function averageCost(positions: readonly MaterialPosition[]): string | null {
+  const onHand = positions.reduce((sum, row) => sum.plus(row.on_hand_base_quantity), new Decimal(0));
+  if (!onHand.gt(0) || positions.some((row) => row.inventory_value_vnd == null)) return null;
+  const value = positions.reduce((sum, row) => sum.plus(row.inventory_value_vnd!), new Decimal(0));
+  return value.div(onHand).toDecimalPlaces(0, Decimal.ROUND_HALF_UP).toFixed(0);
+}
