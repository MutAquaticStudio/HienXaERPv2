# Local development only. Cloud and Production endpoints are rejected by the DB guard.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
HX_CLOUD_RUNTIME_APPROVED=false

# F5 automation (all optional; nothing is sent until configured). The same HX_AUTOMATION_SECRET goes into Supabase Vault as
# hx_automation_secret, together with hx_app_url (the app's public URL). Telegram/webhook secrets live only in Vault.
HX_AUTOMATION_SECRET=
# Email: e.g. Gmail SMTP with an app password (smtp.gmail.com, 465).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Web push (generate once: npx web-push generate-vapid-keys).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@hienxavlxd.com
# FB12 trợ lý AI (Claude Sonnet): server-only key from console.anthropic.com; never a NEXT_PUBLIC_ variable. Empty = the
# "Hỏi AI" page explains that the assistant is not configured.
ANTHROPIC_API_KEY=

# FB18 bản đồ Điều phối: địa chỉ ảnh nền (https, có {z} {x} {y}), ví dụ địa chỉ trong gói CARTO kèm khóa. Trình duyệt tải ảnh
# nên khóa này lộ cho nhân viên — dùng khóa giới hạn theo tên miền của app. Để trống = CARTO Voyager công khai, rồi OpenStreetMap.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
