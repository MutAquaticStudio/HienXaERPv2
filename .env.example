# Local development must use a local Supabase URL or synthetic data only.
APP_ENV=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Safe local UI preview. It is rejected when APP_ENV=production.
ALLOW_LOCAL_SYNTHETIC_AUTH=false

# Production-only, server-side variables. Never put live values in .env.local.
# SUPABASE_SECRET_KEY=
# SUPABASE_DB_URL=
# ALLOW_LIVE_DB_WRITES=false
